diff --git a/dist/context-window.d.ts b/dist/context-window.d.ts
new file mode 100644
index 0000000000000000000000000000000000000000..519301e298eac4315b8c7115305d8e8fa7a4bab6
--- /dev/null
+++ b/dist/context-window.d.ts
@@ -0,0 +1,21 @@
+import type { SessionUpdate } from '@agentclientprotocol/sdk';
+import type { Query } from '@anthropic-ai/claude-agent-sdk';
+
+type UsageUpdate = Extract<SessionUpdate, { sessionUpdate: 'usage_update' }>;
+export declare class ContextWindowTracker {
+    constructor(logger: { error(message: string): void }, timeoutMs?: number);
+    invalidate(clearWindow?: boolean): void;
+    decorate(update: UsageUpdate, authoritative: boolean): UsageUpdate;
+    initialize(
+        query: Pick<Query, 'getContextUsage'>,
+        isCurrent: () => boolean,
+        publish: (update: UsageUpdate) => Promise<void>,
+        fresh: boolean,
+    ): Promise<void>;
+    refresh(
+        query: Pick<Query, 'getContextUsage'>,
+        isCurrent: () => boolean,
+        publish: (update: UsageUpdate) => Promise<void>,
+        windowOnly?: boolean,
+    ): Promise<void>;
+}
diff --git a/dist/context-window.js b/dist/context-window.js
new file mode 100644
index 0000000000000000000000000000000000000000..a193a5d7c4c70c02f0da9fa1bd50e085ca33b9ed
--- /dev/null
+++ b/dist/context-window.js
@@ -0,0 +1,101 @@
+/** @typedef {Extract<import('@agentclientprotocol/sdk').SessionUpdate, { sessionUpdate: 'usage_update' }>} UsageUpdate */
+
+// 每个会话单独保留压缩窗口，不能复用按模型缓存的 API 容量。
+export class ContextWindowTracker {
+    /** @type {number | undefined} */
+    window;
+    /** @type {UsageUpdate | undefined} */
+    latest;
+    revision = 0;
+    windowRevision = 0;
+    pending = false;
+
+    /** @param {{ error(message: string): void }} logger @param {number} timeoutMs */
+    constructor(logger, timeoutMs = 2000) {
+        this.logger = logger;
+        this.timeoutMs = timeoutMs;
+    }
+
+    /** @param {boolean} clearWindow @returns {void} */
+    invalidate(clearWindow = false) {
+        this.revision++;
+        if (clearWindow) {
+            this.window = undefined;
+            this.windowRevision++;
+        }
+    }
+
+    /** @param {UsageUpdate} update @param {boolean} authoritative @returns {UsageUpdate} */
+    decorate(update, authoritative) {
+        this.invalidate();
+        const source = this.window !== undefined ? 'resolved'
+            : authoritative && Number.isFinite(update.size) && update.size > 0 ? 'estimated' : 'unknown';
+        this.latest = {
+            ...update,
+            size: this.window ?? (source === 'estimated' ? update.size : 0),
+            _meta: { ...update._meta, 'emdash.dev/context-window': source },
+        };
+        return this.latest;
+    }
+
+    /**
+     * 初始化后只确认窗口；恢复会话在重放用量前不能发布虚假的零用量。
+     * @param {Pick<import('@anthropic-ai/claude-agent-sdk').Query, 'getContextUsage'>} query
+     * @param {() => boolean} isCurrent
+     * @param {(update: UsageUpdate) => Promise<void>} publish
+     * @param {boolean} fresh
+     * @returns {Promise<void>}
+     */
+    initialize(query, isCurrent, publish, fresh) {
+        if (fresh && !this.latest) {
+            this.latest = { sessionUpdate: 'usage_update', used: 0, size: 0 };
+        }
+        return this.refresh(query, isCurrent, publish, true);
+    }
+
+    /**
+     * 默认在 result 后更新用量；初始化的 windowOnly 模式只更新上限。
+     * @param {Pick<import('@anthropic-ai/claude-agent-sdk').Query, 'getContextUsage'>} query
+     * @param {() => boolean} isCurrent
+     * @param {(update: UsageUpdate) => Promise<void>} publish
+     * @param {boolean} windowOnly
+     * @returns {Promise<void>}
+     */
+    async refresh(query, isCurrent, publish, windowOnly = false) {
+        if (this.pending || (!windowOnly && !this.latest) || !isCurrent()) return;
+        const revision = windowOnly ? this.windowRevision : this.revision;
+        const previous = this.latest;
+        this.pending = true;
+        /** @type {ReturnType<typeof setTimeout> | undefined} */
+        let timer;
+        try {
+            // 超时不取消 SDK 内部请求；直到原请求结束都禁止重复查询，避免堆积。
+            const request = Promise.resolve().then(() => query.getContextUsage({ detail: 'summary' }))
+                .finally(() => { this.pending = false; });
+            const summary = await Promise.race([
+                request,
+                /** @type {Promise<never>} */ (new Promise((_, reject) => {
+                    timer = setTimeout(() => reject(new Error('context usage timeout')), this.timeoutMs);
+                })),
+            ]);
+            if (revision !== (windowOnly ? this.windowRevision : this.revision) || !isCurrent()) return;
+            if (!Number.isSafeInteger(summary.rawMaxTokens) || summary.rawMaxTokens <= 0
+                || !Number.isSafeInteger(summary.totalTokens) || summary.totalTokens < 0) {
+                throw new Error('invalid context usage');
+            }
+            this.window = summary.rawMaxTokens;
+            const usage = windowOnly ? this.latest : previous;
+            if (!usage) return;
+            this.latest = {
+                ...usage, used: windowOnly ? usage.used : summary.totalTokens, size: summary.rawMaxTokens,
+                _meta: { ...usage._meta, 'emdash.dev/context-window': 'resolved' },
+            };
+            await publish(this.latest);
+        } catch {
+            // 不记录 SDK 原始错误，避免自定义后端的响应泄漏认证信息。
+            this.logger.error('[context-window] Summary unavailable; retaining the last known window source.');
+        } finally {
+            clearTimeout(timer);
+        }
+    }
+}
